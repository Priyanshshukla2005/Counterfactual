# Backend Environment Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=counterfactual
AUTH_SECRET=your_jwt_auth_secret_key_change_in_production
JWT_SECRET=your_jwt_auth_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Razorpay Test/Sandbox Configuration (Server-side Only)
