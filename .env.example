# MongoDB Connection Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=counterfactual

# Authentication & Session Security (Replace with high-entropy random string in production)
AUTH_SECRET=your_jwt_auth_secret_key_change_in_production
JWT_SECRET=your_jwt_auth_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24

# Server & Network Configuration
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
